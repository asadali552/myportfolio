{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(login|info|skills|projects|articles|analytics|messages)(/.*)?",
      "dest": "backend/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/robots.txt",
      "dest": "frontend/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "frontend/sitemap.xml"
    },
    {
      "src": "/site.webmanifest",
      "dest": "frontend/site.webmanifest"
    },
    {
      "src": "/og-image.png",
      "dest": "frontend/og-image.png"
    },
    {
      "src": "/data.json",
      "dest": "frontend/data.json"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
